# Copy to .env and fill in. .env is gitignored — never commit your key.
ANTHROPIC_API_KEY=

# Default model for extraction and checking.
# s across models; this is just the default.
PRIORAUTH_MODEL=claude-sonnet-5

# Set to 0 to bypass the LLM response cache (you almost never want this)
PRIORAUTH_CACHE=1

# Prod only (Render/Supabase deployment) -- leave unset for local dev, which
# always uses the canonical SQLite file at data/priorauth.db. See db.py.
# DATABASE_URL=postgres://user:pass@host:port/dbname
